const express = require("express");
const http = require("http");

const app = express();
const server = http.createServer(app);

const bus = require("../telemetry/emitter");

let initialized = false;

function boot() {
  if (initialized) return console.log("🧠 AFRISCAN: already booted");

  initialized = true;

  try {
    require("../graph/builder")(app);
  } catch (e) {}

  try {
    require("../ai/gateway/v5/admin/dashboard")(app);
  } catch (e) {}

  const PORT = process.env.PORT || 3000;

  server.listen(PORT, () => {
    console.log("🧠 AFRISCAN CONTROL RUNTIME ACTIVE →", PORT);
  });

  setInterval(() => {
    bus.emit("telemetry", {
      memory: process.memoryUsage(),
      pid: process.pid,
      time: Date.now()
    });
  }, 2000);
}

module.exports = { boot };
