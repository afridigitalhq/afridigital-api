const { createAfriBrainMesh } = require("./core/mesh/bootstrap/afribrainMesh");
const { initBus } = require("./core/flow/mesh/eventBus");
const createApp = require('./core/runtime/bootstrap');
const app = createApp();
const { startKernelTick } = require("./core/kernel/tick/kernelTick");
const { createFlowSocket } = require("./core/flow/ws/flowSocket.js");
const bus = require("./core/redis/streamBus");
app.use("/webhook/whatsapp", require("./routes/a2.webhook"));
app.use("/flow", require("./core/flow/router"));
app.use("/flow", require("./routes/flow.routes"));
app.use("/attention", require("./routes/attention.routes"));
app.use("/flow/runtime", require("./routes/flow.runtime.routes"));
const flow = require('./core/flow/router');
app.use('/flow', flow);


// optional observability (safe guard)
try {
  const { registerDashboardStream } = require('./core/observability/v4/stream/sseTraceStream');
  registerDashboardStream(app, bus);
} catch (e) {
  console.log("⚠️ dashboard stream skipped");
}

const PORT = process.env.PORT || 3000;

app.get("/neurograph", (req,res)=> res.sendFile(require("path").join(__dirname,"core/flow/ui/neurograph.html")) );
const { createAfriBrainSocket } = require("./core/flow/ws/flowSocket.js");
createAfriBrainSocket(server);
const server = app.listen(PORT, "0.0.0.0", () => {
createFlowSocket(server, bus);
startKernelTick({ interval: 200 });
const { startPhysicsLoop } = require("./core/flow/physics/tick");
startPhysicsLoop();
const { attachFlowStream } = require("./core/flow/stream/flowStream"); attachFlowStream(app);
  console.log("🚀 AFRI KERNEL v2 RUNNING ON", PORT);
});

process.on('SIGINT', () => server.close());
process.on('SIGTERM', () => server.close());

module.exports = app;
