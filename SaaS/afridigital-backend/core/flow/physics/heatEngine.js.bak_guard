const { getSynapticGraph } = require("../synapse/edgeEngine");

const heatMap = new Map();

/**
 * Inject energy into a node
 */
function injectHeat(node, energy = 1) {
  const current = heatMap.get(node) || 0;
  heatMap.set(node, current + energy);
}

/**
 * Propagate heat through synapses (diffusion model)
 */
function propagateHeat() {
  const edges = getSynapticGraph();

  const transfers = new Map();

  for (const edge of edges) {
    const fromHeat = heatMap.get(edge.from) || 0;

    if (fromHeat <= 0.01) continue;

    // transfer strength = heat × weight
    const transfer = fromHeat * edge.weight * 0.15;

    if (transfer <= 0.001) continue;

    transfers.set(
      edge.to,
      (transfers.get(edge.to) || 0) + transfer
    );

    // loss on source
    heatMap.set(edge.from, fromHeat * 0.92);
  }

  // apply transfers
  for (const [node, value] of transfers.entries()) {
    injectHeat(node, value);
  }
}

/**
 * Natural decay (cooling)
 */
function coolDown() {
  for (const [node, heat] of heatMap.entries()) {
    heatMap.set(node, heat * 0.96);

    if (heatMap.get(node) < 0.01) {
      heatMap.delete(node);
    }
  }
}

/**
 * Snapshot for WebGL renderer
 */
function getHeatState() {
  return Object.fromEntries(heatMap.entries());
}

module.exports = {
  injectHeat,
  propagateHeat,
  coolDown,
  getHeatState
};
