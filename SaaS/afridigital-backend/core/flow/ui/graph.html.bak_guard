<!DOCTYPE html>
<html>
<head>
  <title>Flow Brain Graph</title>
  <style>
    body { background:#0b0f1a; color:#00ffd5; font-family:monospace; }
    .node { margin:6px; padding:6px; border-left:3px solid #00ffd5; }
  </style>
</head>
<body>

<h3>🧠 Live FlowGraph Execution Map</h3>
<div id="log"></div>

<script>
const ws = new WebSocket("ws://" + location.host);

ws.onmessage = (msg) => {
  const data = JSON.parse(msg.data);
  if (data.type !== "flow:event") return;

  const div = document.createElement("div");
  div.className = "node";
  div.innerText =
    data.data.node + " → " + data.data.action + " [" + data.data.status + "]";

  document.getElementById("log").prepend(div);
};
</script>

</body>
</html>
