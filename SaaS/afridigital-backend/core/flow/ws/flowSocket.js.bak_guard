const WebSocket = require("ws");
const { subscribe } = require("../mesh/eventBus");

function createFlowSocket(server) {
  const wss = new WebSocket.Server({ server });
const { attachSynapseStream } = require("../ws/synapseStream");

  wss.on("connection", (ws) => {
    ws.send(JSON.stringify({ type: "connected", ok: true }));

    subscribe("flowgraph:event", (event) => {
      ws.send(JSON.stringify({
        type: "flow:event",
        payload: event
      }));
    });
  });

  console.log("🧠 Flow WebSocket Gateway ACTIVE");
attachSynapseStream(wss);
}

module.exports = { createFlowSocket };
