const { getSynapticGraph } = require("../synapse/edgeEngine");

function attachSynapseStream(wss) {
  setInterval(() => {
    const graph = getSynapticGraph();

    wss.clients.forEach(client => {
      if (client.readyState === 1) {
        client.send(JSON.stringify({
          type: "synapse:graph",
          payload: graph
        }));
      }
    });

  }, 1000);
}

module.exports = { attachSynapseStream };
