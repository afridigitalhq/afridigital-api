const WebSocket = require("ws");
const mesh = require("../mesh/eventMesh");
const Redis = require("ioredis");

let redisStatus = "unknown";
let redis = null;

try {
  redis = new Redis();
  redis.ping().then(() => redisStatus = "online").catch(() => redisStatus = "offline");
} catch (e) {
  redisStatus = "fallback";
}

function createAfriBrainSocket(server) {
  const wss = new WebSocket.Server({ server });

  console.log("🧠 AfriBrain WS Dashboard Online");

  wss.on("connection", (ws) => {

    // initial system snapshot
    ws.send(JSON.stringify({
      type: "system:init",
      payload: {
        status: "online",
        redis: redisStatus,
        time: Date.now()
      }
    }));

    const handler = (event) => {
      if (ws.readyState === 1) {
        ws.send(JSON.stringify({
          type: "brain:pulse",
          payload: {
            event,
            heartbeat: Date.now()
          }
        }));
      }
    };

    mesh.subscribe("flowgraph:event", handler);
  });
}

module.exports = { createAfriBrainSocket };
