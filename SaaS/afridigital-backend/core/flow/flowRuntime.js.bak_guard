const { publish } = require("./stream/eventMesh");
const { pushToLane } = require("./lane/executionLanes");
const { record } = require("./replay/eventReplay");
const { buildBrainGraph } = require("./ui/brainGraphLive");

/**
 * Central FlowGraph execution engine
 */
function runFlow(event, context = {}) {

  const enriched = {
    ...event,
    user: context.user || "anonymous",
    ts: Date.now()
  };

  // 1. lane isolation
  if (context.user) {
    pushToLane(context.user, enriched);
  }

  // 2. replay buffer
  record(enriched);

  // 3. event mesh broadcast
  publish("flowgraph:event", enriched);

  // 4. UI transformation
  const ui = buildBrainGraph(enriched);

  return {
    ok: true,
    event: enriched,
    ui
  };
}

module.exports = { runFlow };
