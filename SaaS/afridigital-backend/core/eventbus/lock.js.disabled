/**
 * AFRIDIGITAL EVENT BUS LOCK
 * Prevents multiple event systems from existing
 */

const fs = require('fs');
const path = require('path');

const FORBIDDEN_PATTERNS = [
  '../bus',
  '../eventBus',
  '../../africore/eventbus/bus',
  '../events/apiEventBus',
  '../events/bus'
];

function scanFile(file) {
  const content = fs.readFileSync(file, 'utf8');
  for (const pattern of FORBIDDEN_PATTERNS) {
    if (content.includes(pattern)) {
      console.error('🚨 EVENT BUS VIOLATION:', file);
      console.error('❌ Forbidden import:', pattern);
      process.exit(1);
    }
  }
}

function scanDir(dir) {
  for (const f of fs.readdirSync(dir)) {
    const p = path.join(dir, f);
    if (fs.statSync(p).isDirectory()) scanDir(p);
    else if (p.endsWith('.js')) scanFile(p);
  }
}

// Run lock check on startup
scanDir(path.join(__dirname, '..'));

console.log('🔒 EVENT BUS LOCK ACTIVE - SYSTEM CLEAN');
