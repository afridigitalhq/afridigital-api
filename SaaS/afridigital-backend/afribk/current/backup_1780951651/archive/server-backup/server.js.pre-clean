const express = require('express');
const app = express();

const { getBatch } = require('./core/kernel/replay.engine.v3');

app.get('/replay/status', async (req, res) => {
  const batch = await getBatch(100);

  res.json({
    queueSize: batch.length,
    retries: batch.reduce((s, i) => s + i.attempts, 0),
    oldest: batch[0]?.createdAt || null,
    status: batch.length ? 'active' : 'idle'
  });
});

module.exports = app;
