#!/bin/bash

echo "🧊 KERNEL FREEZE v2.1 (DEDUP GUARD ACTIVE)"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

BASE="."

QUARANTINE="afribk/blocked_duplicates_$(date +%s)"
mkdir -p "$QUARANTINE"

REPORT="core/kernel/freeze-report.log"
: > "$REPORT"

echo "🔍 Scanning runtime entries..."

# 1. Find ALL runtime entry points
FILES=$(grep -R "app.listen\|http.listen\|server.listen" . \
  --exclude-dir=node_modules \
  --exclude-dir=.git \
  --exclude-dir=afribk \
  | cut -d: -f1 | sort)

TOTAL=$(echo "$FILES" | wc -l)

echo "📦 Total runtime occurrences: $TOTAL" | tee -a "$REPORT"

# 2. Detect duplicates (file appears more than once)
echo ""
echo "🧠 Detecting duplicates..."

DUPLICATES=$(echo "$FILES" | sort | uniq -c | awk '$1 > 1')

if [ ! -z "$DUPLICATES" ]; then
  echo "🚨 DUPLICATES DETECTED:" | tee -a "$REPORT"
  echo "$DUPLICATES" | tee -a "$REPORT"

  echo ""
  echo "🛑 AUTO-BLOCKING DUPLICATE FILES..."

  echo "$DUPLICATES" | while read count file; do
    if [ -f "$file" ]; then
      mkdir -p "$QUARANTINE"

      cp "$file" "$QUARANTINE/$(basename "$file").blocked"

      echo "⛔ BLOCKED: $file (duplicates: $count)" | tee -a "$REPORT"

      # neutralize file instead of deleting
      echo "// BLOCKED BY KERNEL FREEZE v2.1 - DUPLICATE DETECTED" > "$file"
    fi
  done
else
  echo "🟢 No duplicates found" | tee -a "$REPORT"
fi

# 3. Final safety check
RECHECK=$(grep -R "app.listen\|http.listen\|server.listen" . \
  --exclude-dir=node_modules \
  --exclude-dir=afribk \
  | wc -l)

echo ""
echo "📊 POST-FREEZE COUNT: $RECHECK"

if [ "$RECHECK" -gt 1 ]; then
  echo "🔴 WARNING: Residual runtime duplication exists" | tee -a "$REPORT"
else
  echo "🟢 CLEAN SINGLE RUNTIME STATE ACHIEVED" | tee -a "$REPORT"
fi

echo ""
echo "📁 Quarantine folder: $QUARANTINE"
echo "📄 Report saved: $REPORT"

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "🧊 FREEZE v2.1 COMPLETE"
